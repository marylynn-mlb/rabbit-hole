{
  "manifest_version": 3,
  "name": "Rabbit Hole",
  "version": "0.1.0",
  "description": "Follow one trail of curiosity through your tabs, then look back over where it went.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Rabbit Hole",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": { "default_path": "panel.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["tabs", "webNavigation", "storage", "unlimitedStorage", "sidePanel", "alarms", "idle"]
}
